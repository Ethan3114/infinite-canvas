# 复制本文件为 backend/.env 后填写。不要把填好的文件发给任何人或贴进对话。

INVITE_CODE=studio-demo
SESSION_SECRET=change-me

# DeepSeek 识图模型。模型名以你控制台里能看图的那个为准。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=

# 商汤生图。三把钥匙用英文逗号隔开，不要加空格以外的符号。
SENSETIME_API_KEYS=
SENSETIME_BASE_URL=https://token.sensenova.cn/v1
SENSETIME_MODEL=sensenova-u1.5-lite

# 蚂蚁视频。只用视频模型。720P、3 秒、首尾帧，一段大约 270 点。
ANT_API_KEY=
ANT_BASE_URL=https://maas-api.antdigital.com
ANT_VIDEO_MODEL=wan2.7-i2v
